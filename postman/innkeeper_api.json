{
  "info": {
    "name": "Innkeeper API",
    "_postman_id": "innkeeper-api-collection-v1",
    "description": "API collection for Innkeeper federated social platform. Run these tests with the Newman CLI or Postman.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://localhost:8000",
      "type": "string"
    },
    {
      "key": "access_token",
      "value": "",
      "type": "string"
    },
    {
      "key": "author_id",
      "value": "",
      "type": "string"
    },
    {
      "key": "post_id",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Register",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 201', function() {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "",
                  "pm.test('Response has message', function() {",
                  "    const body = pm.response.json();",
                  "    pm.expect(body).to.have.property('message');",
                  "    pm.expect(body).to.have.property('username');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"username\": \"testuser\",\n    \"email\": \"test@example.com\",\n    \"password\": \"testpass123\",\n    \"password2\": \"testpass123\",\n    \"display_name\": \"Test User\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/auth/register/",
              "host": ["{{base_url}}"],
              "path": ["api", "auth", "register", ""]
            }
          }
        },
        {
          "name": "Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 200', function() {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test('Response has tokens', function() {",
                  "    const body = pm.response.json();",
                  "    pm.expect(body).to.have.property('access');",
                  "    pm.expect(body).to.have.property('refresh');",
                  "    // Save the token for use in other requests",
                  "    pm.collectionVariables.set('access_token', body.access);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"username\": \"admin\",\n    \"password\": \"adminpass\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/auth/login/",
              "host": ["{{base_url}}"],
              "path": ["api", "auth", "login", ""]
            }
          }
        },
        {
          "name": "Get Current User",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 200', function() {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test('Response has user data', function() {",
                  "    const body = pm.response.json();",
                  "    pm.expect(body).to.have.property('id');",
                  "    pm.expect(body).to.have.property('username');",
                  "    pm.collectionVariables.set('author_id', body.id);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{access_token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/auth/me/",
              "host": ["{{base_url}}"],
              "path": ["api", "auth", "me", ""]
            }
          }
        }
      ]
    },
    {
      "name": "Authors",
      "item": [
        {
          "name": "List All Authors",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 200', function() {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test('Response is array or paginated', function() {",
                  "    const body = pm.response.json();",
                  "    // Either direct array or paginated",
                  "    pm.expect(body).to.satisfy(b => Array.isArray(b) || b.hasOwnProperty('results'));",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/api/authors/",
              "host": ["{{base_url}}"],
              "path": ["api", "authors", ""]
            }
          }
        },
        {
          "name": "Get Author Detail",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 200', function() {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test('Author has required fields', function() {",
                  "    const body = pm.response.json();",
                  "    pm.expect(body).to.have.property('id');",
                  "    pm.expect(body).to.have.property('username');",
                  "    pm.expect(body).to.have.property('url');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/api/authors/{{author_id}}/",
              "host": ["{{base_url}}"],
              "path": ["api", "authors", "{{author_id}}", ""]
            }
          }
        }
      ]
    },
    {
      "name": "Posts",
      "item": [
        {
          "name": "Create Post",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 201', function() {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "",
                  "pm.test('Post was created', function() {",
                  "    const body = pm.response.json();",
                  "    pm.expect(body).to.have.property('id');",
                  "    pm.expect(body).to.have.property('content');",
                  "    pm.collectionVariables.set('post_id', body.id);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{access_token}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"title\": \"Test Post\",\n    \"content\": \"This is a test post content\",\n    \"content_type\": \"text/plain\",\n    \"visibility\": \"PUBLIC\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/posts/",
              "host": ["{{base_url}}"],
              "path": ["api", "posts", ""]
            }
          }
        },
        {
          "name": "List Public Posts",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 200', function() {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test('Posts have required fields', function() {",
                  "    const body = pm.response.json();",
                  "    const posts = body.results || body;",
                  "    if (posts.length > 0) {",
                  "        pm.expect(posts[0]).to.have.property('id');",
                  "        pm.expect(posts[0]).to.have.property('content');",
                  "        pm.expect(posts[0]).to.have.property('author_info');",
                  "    }",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/api/posts/",
              "host": ["{{base_url}}"],
              "path": ["api", "posts", ""]
            }
          }
        },
        {
          "name": "Get Post Detail",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 200', function() {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test('Post includes comments', function() {",
                  "    const body = pm.response.json();",
                  "    pm.expect(body).to.have.property('comments');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/api/posts/{{post_id}}/",
              "host": ["{{base_url}}"],
              "path": ["api", "posts", "{{post_id}}", ""]
            }
          }
        },
        {
          "name": "Like a Post",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 200', function() {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test('Response indicates liked status', function() {",
                  "    const body = pm.response.json();",
                  "    pm.expect(body).to.have.property('liked');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{access_token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/posts/{{post_id}}/like/",
              "host": ["{{base_url}}"],
              "path": ["api", "posts", "{{post_id}}", "like", ""]
            }
          }
        }
      ]
    },
    {
      "name": "Comments",
      "item": [
        {
          "name": "Add Comment",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 201', function() {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "",
                  "pm.test('Comment was created', function() {",
                  "    const body = pm.response.json();",
                  "    pm.expect(body).to.have.property('id');",
                  "    pm.expect(body).to.have.property('content');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{access_token}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"content\": \"Great post!\",\n    \"content_type\": \"text/plain\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/posts/{{post_id}}/comments/",
              "host": ["{{base_url}}"],
              "path": ["api", "posts", "{{post_id}}", "comments", ""]
            }
          }
        }
      ]
    },
    {
      "name": "Federation",
      "item": [
        {
          "name": "Get Inbox",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 200', function() {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test('Response has inbox structure', function() {",
                  "    const body = pm.response.json();",
                  "    pm.expect(body).to.have.property('type');",
                  "    pm.expect(body.type).to.equal('inbox');",
                  "    pm.expect(body).to.have.property('items');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{access_token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/authors/{{author_id}}/inbox/",
              "host": ["{{base_url}}"],
              "path": ["api", "authors", "{{author_id}}", "inbox", ""]
            }
          }
        },
        {
          "name": "Send to Inbox (Federation)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 201', function() {",
                  "    pm.response.to.have.status(201);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"type\": \"post\",\n    \"title\": \"Hello from another node!\",\n    \"content\": \"This post came from a remote node\",\n    \"author\": {\n        \"url\": \"http://othernode.com/api/authors/some-uuid\",\n        \"username\": \"remoteuser\"\n    }\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/authors/{{author_id}}/inbox/",
              "host": ["{{base_url}}"],
              "path": ["api", "authors", "{{author_id}}", "inbox", ""]
            }
          }
        }
      ]
    }
  ]
}
